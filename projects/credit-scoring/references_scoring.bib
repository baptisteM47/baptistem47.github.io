@article{rahmah2021_covid_financial_distress, title = {Comparative Analysis of Financial Distress Before and During the COVID-19 Pandemic: Empirical Evidence in Indonesia}, author = {Rahmah, Ismayati and Novianty, Ira}, journal = {International Journal of Business, Economics and Law}, volume = {24}, number = {5}, year = {2021}, month = {August}, issn = {2289-1552}, abstract = {This study analyzes differences in financial distress conditions before and during the COVID-19 pandemic in Indonesia using the Altman Z-Score model. Focusing on hotel, restaurant, and tourism companies, the results show a significant decline in Z-Score values during the pandemic, indicating increased financial distress.} }

